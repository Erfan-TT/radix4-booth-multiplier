ometry"/></mxCell><mxCell id="n114" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="680" y="1696.26" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n115" value="-1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1732.03" width="37.3316" height="27.0395" as="geometry"/></mxCell><mxCell id="n116" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="280" y="1732.03" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n117" value="0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="480" y="1732.03" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n118" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="680" y="1732.03" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n119" value="-2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1767.8" width="37.3316" height="27.0395" as="geometry"/></mxCell><mxCell id="n120" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="280" y="1767.8" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n121" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="480" y="1767.8" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n122" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#101418;fontFamily=Courier New;resizable=0;" vertex="1" parent="1"><mxGeometry x="680" y="1767.8" width="24.6658" height="27.0395" as="geometry"/></mxCell><mxCell id="n123" value="sel(0) = 1: the digit is not 0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1813.56" width="340.216" height="27.0395" as="geometry"/></mxCell><mxCell id="n124" value="sel(1) = 1: |digit| = 2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1849.33" width="263.632" height="27.0395" as="geometry"/></mxCell><mxCell id="n125" value="sel(2) = 1: the digit is negative" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1885.1" width="373.038" height="27.0395" as="geometry"/></mxCell><mxCell id="n126" value="fused_selector  (step 4)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30.5073;fontColor=#101418;fontFamily=Helvetica;fontStyle=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="79.4927" width="392.731" height="36.5073" as="geometry"/></mxCell><mxCell id="n127" value="decode the four non-zero digits once, then one AND-OR per bit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="128.936" width="679.373" height="27.0395" as="geometry"/></mxCell><mxCell id="n128" value="decoder (left): once per row, shared by the N+1 bits of the row" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1698.96" width="701.254" height="27.0395" as="geometry"/></mxCell><mxCell id="n129" value="slice (right): per bit 4 AND2 + 1 OR4, which maps onto AOI/OAI cells" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1732.62" width="755.956" height="27.0395" as="geometry"/></mxCell><mxCell id="n130" value="no XOR: the negation is the inverted data input of neg1 / neg2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1766.29" width="690.313" height="27.0395" as="geometry"/></mxCell><mxCell id="n131" value="src1(i) = A(i),  src2(i) = A(i-1);  bit N inverted as on the left" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1799.95" width="723.135" height="27.0395" as="geometry"/></mxCell><mxCell id="n132" value="pos1 = sel(0) . /sel(1) . /sel(2)  (+A)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1833.61" width="438.681" height="27.0395" as="geometry"/></mxCell><mxCell id="n133" value="neg1 = sel(0) . /sel(1) . sel(2)  (-A)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1867.28" width="427.74" height="27.0395" as="geometry"/></mxCell><mxCell id="n134" value="pos2 = sel(0) . sel(1) . /sel(2)  (+2A)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1900.94" width="438.681" height="27.0395" as="geometry"/></mxCell><mxCell id="n135" value="neg2 = sel(0) . sel(1) . sel(2)  (-2A)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="1580" y="1934.6" width="427.74" height="27.0395" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>