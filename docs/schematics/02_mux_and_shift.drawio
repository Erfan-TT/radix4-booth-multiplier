middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1218.96" width="745.016" height="27.0395" as="geometry"/></mxCell><mxCell id="n95" value="sel(2) drives N+1 XOR gates: a separate negation layer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1252.62" width="602.789" height="27.0395" as="geometry"/></mxCell><mxCell id="n96" value="bit N (the sign) is inverted after the XOR; bits above N are 0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1286.29" width="690.313" height="27.0395" as="geometry"/></mxCell><mxCell id="n97" value="mux input 0 = A(i) (1 x A),  input 1 = A(i-1) (2 x A, shifted)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1319.95" width="690.313" height="27.0395" as="geometry"/></mxCell><mxCell id="n98" value="booth_encoder output" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24.1954;fontColor=#101418;fontFamily=Helvetica;fontStyle=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1535.8" width="263.632" height="30.1954" as="geometry"/></mxCell><mxCell id="n99" value="digit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor=#475467;fontFamily=Helvetica;fontStyle=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="80" y="1588.96" width="66.7027" height="27.0395" as="geometry"/></mxCell><mxCell id="n100" value="sel(2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=21.0395;fontColor